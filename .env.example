# Copy this file to .env and fill in your keys. Never commit .env.

# Groq (primary LLM): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key

# Gemini (fallback LLM): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.5-flash

# Hindsight Cloud (memory): use the URL and key from your Hindsight dashboard
HINDSIGHT_BASE_URL=your_hindsight_server_address
HINDSIGHT_API_KEY=your_hindsight_key
